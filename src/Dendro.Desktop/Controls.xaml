<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="clr-namespace:Dendro.Desktop"
>
  <SolidColorBrush x:Key="Ui.Text" Color="#263D52" />
  <SolidColorBrush x:Key="Ui.Muted" Color="#5B7082" />
  <SolidColorBrush x:Key="Ui.Accent" Color="#21669D" />
  <SolidColorBrush x:Key="Ui.Border" Color="#D6E0EC" />
  <SolidColorBrush x:Key="Ui.Surface" Color="#F5F8FB" />
  <SolidColorBrush x:Key="Ui.Critical" Color="#8C2934" />
  <Style x:Key="ScrollPageArea" TargetType="RepeatButton">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ScrollHandle" TargetType="Thumb">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="MinWidth" Value="6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Handle" Background="#9AAFBF" CornerRadius="4" Margin="3,2" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Handle" Property="Background" Value="#627F96" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
              <Setter TargetName="Handle" Property="Background" Value="{StaticResource Ui.Accent}" />
            </Trigger>
            <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
              <Setter TargetName="Handle" Property="Margin" Value="2,3" />
            </DataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal">
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="0" />
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="ScrollBar">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Width" Value="14" />
    <Setter Property="Background" Value="{StaticResource Ui.Surface}" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Border Background="{TemplateBinding Background}" CornerRadius="5">
            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                   ViewportSize="{TemplateBinding ViewportSize}">
              <Track.DecreaseRepeatButton>
                <RepeatButton x:Name="PageDecrease" Style="{StaticResource ScrollPageArea}" Command="{x:Static ScrollBar.PageUpCommand}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollHandle}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton x:Name="PageIncrease" Style="{StaticResource ScrollPageArea}" Command="{x:Static ScrollBar.PageDownCommand}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
              <Setter TargetName="PageDecrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}" />
              <Setter TargetName="PageIncrease" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="14" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <DataTemplate x:Key="ActionLabel">
    <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" />
  </DataTemplate>
  <Style x:Key="CompactDateToggleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="29" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="MinHeight" Value="29" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style x:Key="CompactDateCalendar" TargetType="Calendar">
    <Setter Property="Foreground" Value="#304A60" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource Ui.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style TargetType="CalendarDayButton">
    <Setter Property="Foreground" Value="#304A60" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinWidth" Value="30" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="2" />
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{StaticResource Ui.Accent}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#E3EEF9" />
        <Setter Property="BorderBrush" Value="#85ADD1" />
      </Trigger>
      <Trigger Property="IsToday" Value="True">
        <Setter Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="CalendarButton">
    <Setter Property="Foreground" Value="#304A60" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="4,2" />
  </Style>
  <Style TargetType="Button">
    <Setter Property="Foreground" Value="#25425D" />
    <Setter Property="Background" Value="#F1F5FA" />
    <Setter Property="BorderBrush" Value="{StaticResource Ui.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="13,8" />
    <Setter Property="Margin" Value="3" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
            x:Name="Border"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="5"
            Padding="{TemplateBinding Padding}"
          >
            <ContentPresenter
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="Center"
              RecognizesAccessKey="True"
            />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="#E3EEF9" />
              <Setter TargetName="Border" Property="BorderBrush" Value="#85ADD1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="#CFE2F5" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SecondaryActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}" />
  <Style x:Key="PrimaryActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="{StaticResource Ui.Accent}" />
    <Setter Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
            x:Name="Border"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="5"
            Padding="{TemplateBinding Padding}"
          >
            <ContentPresenter
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="Center"
              RecognizesAccessKey="True"
            />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="#1B5683" />
              <Setter TargetName="Border" Property="BorderBrush" Value="#1B5683" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="#16466D" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="#153F61" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CriticalPrimaryActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Background" Value="{StaticResource Ui.Critical}" />
    <Setter Property="BorderBrush" Value="{StaticResource Ui.Critical}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
            x:Name="Border"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="5"
            Padding="{TemplateBinding Padding}"
          >
            <ContentPresenter
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="Center"
              RecognizesAccessKey="True"
            />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="#76232D" />
              <Setter TargetName="Border" Property="BorderBrush" Value="#76232D" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="#641D26" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="#4B1620" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DangerActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Foreground" Value="{StaticResource Ui.Critical}" />
    <Setter Property="Background" Value="#FFF1F2" />
    <Setter Property="BorderBrush" Value="#E9B9BE" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border
            x:Name="Border"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="5"
            Padding="{TemplateBinding Padding}"
          >
            <ContentPresenter
              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalAlignment="Center"
              RecognizesAccessKey="True"
            />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Border" Property="Background" Value="#FFE1E4" />
              <Setter TargetName="Border" Property="BorderBrush" Value="#D8858F" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Border" Property="Background" Value="#F9CDD2" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="#B34856" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="#304A60" />
    <Setter Property="Margin" Value="0,5,0,7" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
              x:Name="Box"
              Width="16"
              Height="16"
              Margin="0,0,8,0"
              Background="White"
              BorderBrush="#AAB9C8"
              BorderThickness="1"
              CornerRadius="3"
              VerticalAlignment="Center"
            >
              <Path
                x:Name="Mark"
                Data="M 3 8 L 6.5 11.5 L 13 4.5"
                Stroke="White"
                StrokeThickness="1.8"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                Visibility="Collapsed"
              />
            </Border>
            <ContentPresenter
              Grid.Column="1"
              VerticalAlignment="Center"
              RecognizesAccessKey="True"
              ContentSource="Content"
            />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Ui.Accent}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
              <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.48" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="StatusProgress" TargetType="ProgressBar">
    <Setter Property="Background" Value="#E5EBF1" />
    <Setter Property="Foreground" Value="{StaticResource Ui.Accent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border
            x:Name="PART_Track"
            Background="{TemplateBinding Background}"
            CornerRadius="5"
            ClipToBounds="True"
            SnapsToDevicePixels="True"
          >
            <Grid ClipToBounds="True">
              <Border
                x:Name="PART_Indicator"
                HorizontalAlignment="Left"
                Background="{TemplateBinding Foreground}"
                CornerRadius="5"
              />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ToolBackButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="Margin" Value="0,0,5,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style TargetType="TextBox">
    <Setter Property="Foreground" Value="#233C52" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#CCD8E5" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="Margin" Value="0,3,0,9" />
    <Setter Property="MinHeight" Value="33" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border
            x:Name="Border"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="5"
            Padding="{TemplateBinding Padding}"
          >
            <ScrollViewer x:Name="PART_ContentHost" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="#233C52" />
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#CCD8E5" />
    <Setter Property="Margin" Value="0,3,0,9" />
    <Setter Property="MinHeight" Value="33" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton
              Focusable="False"
              Foreground="{TemplateBinding Foreground}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}"
            >
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent">
                    <ContentPresenter />
                  </Border>
                </ControlTemplate>
              </ToggleButton.Template>
              <Border
                x:Name="Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="{TemplateBinding Padding}"
              >
                <DockPanel>
                  <Path
                    DockPanel.Dock="Right"
                    Data="M 0 0 L 4 4 L 8 0"
                    Stroke="#55728A"
                    StrokeThickness="1.4"
                    VerticalAlignment="Center"
                    Margin="12,0,1,0"
                  />
                  <ContentPresenter
                    Content="{TemplateBinding SelectionBoxItem}"
                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                    VerticalAlignment="Center"
                  />
                </DockPanel>
              </Border>
            </ToggleButton>
            <Popup
              x:Name="PART_Popup"
              IsOpen="{TemplateBinding IsDropDownOpen}"
              Placement="Bottom"
              AllowsTransparency="True"
              Focusable="False"
            >
              <Border
                Background="White"
                BorderBrush="#BDCDDE"
                BorderThickness="1"
                CornerRadius="5"
                MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"
                MaxHeight="360"
                Padding="3"
              >
                <ScrollViewer CanContentScroll="True">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Padding" Value="8,7" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border
            x:Name="Bg"
            Background="Transparent"
            CornerRadius="3"
            Padding="{TemplateBinding Padding}"
          >
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="#E6F0FA" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="#DCEBFA" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="TabItem">
    <Setter Property="Foreground" Value="#60778C" />
    <Setter Property="Padding" Value="14,9" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border
            x:Name="Bg"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="0,0,0,2"
            Padding="{TemplateBinding Padding}"
          >
            <ContentPresenter ContentSource="Header" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Ui.Accent}" />
              <Setter TargetName="Bg" Property="Background" Value="White" />
              <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Ui.Accent}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bg" Property="Background" Value="#EFF5FB" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="RibbonCommand" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinWidth" Value="94" />
    <Setter Property="MinHeight" Value="64" />
    <Setter Property="ContentTemplate">
      <Setter.Value>
        <DataTemplate>
          <StackPanel HorizontalAlignment="Center">
            <local:CommandIcon
              Kind="{Binding Tag,RelativeSource={RelativeSource AncestorType=Button}}"
              Margin="0,0,0,6"
            />
            <TextBlock
              Text="{Binding}"
              FontSize="12"
              TextAlignment="Center"
              TextWrapping="Wrap"
              MaxWidth="145"
            />
          </StackPanel>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
