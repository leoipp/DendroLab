<Window
  x:Class="Dendro.Desktop.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:ad="https://github.com/Dirkster99/AvalonDock"
  xmlns:local="clr-namespace:Dendro.Desktop"
  xmlns:themes="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.VS2013"
  xmlns:adc="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
  FontFamily="Segoe UI"
  FontSize="13"
  Foreground="#263D52"
  Title="DendroLab"
  Icon="Assets/logo.ico"
  Width="1500"
  Height="1000"
  MinWidth="1050"
  MinHeight="680"
  WindowStartupLocation="CenterScreen"
  Closing="OnClosing"
  AllowDrop="True"
  Drop="OnDrop"
  UseLayoutRounding="True"
>
  <DockPanel>
    <Border x:Name="RibbonHost" DockPanel.Dock="Top" Background="White" BorderBrush="#DBE3EC" BorderThickness="0,0,0,1" MouseLeave="RibbonMouseLeave">
      <DockPanel>
        <Button x:Name="RibbonPin" DockPanel.Dock="Right" Click="RibbonPinClick" VerticalAlignment="Top" Width="22" Height="22" Margin="5,8,8,0" Padding="0" ToolTip="Desafixar menu (Ctrl+F1)" AutomationProperties.Name="Desafixar menu">
          <Button.Resources>
            <ResourceDictionary Source="/AvalonDock.Themes.VS2013;component/Themes/Icons/IconGeometry.xaml" />
          </Button.Resources>
          <Button.Template>
            <ControlTemplate TargetType="Button">
              <Border x:Name="PinBackground" Background="Transparent" CornerRadius="2">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PinBackground" Property="Background" Value="#E5EFF7" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="PinBackground" Property="Background" Value="#E5EFF7" /></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Button.Template>
          <Path x:Name="RibbonPinGlyph" Data="{StaticResource PinAutoHide}" Fill="#304A60" Width="10" Height="10" Stretch="Uniform" />
        </Button>
        <TabControl x:Name="Ribbon" Height="140" BorderThickness="0" PreviewMouseLeftButtonUp="RibbonTabClick" SelectionChanged="RibbonTabChanged" ClipToBounds="True">
          <TabItem Header="Projeto">
            <StackPanel Orientation="Horizontal" Margin="9,4">
              <StackPanel>
                <WrapPanel>
                  <Button
                    Content="Novo projeto"
                    Click="NewClick"
                    Style="{StaticResource RibbonCommand}"
                    Tag="New"
                  />
                  <Button
                    Content="Abrir projeto"
                    Click="OpenClick"
                    Style="{StaticResource RibbonCommand}"
                    Tag="Open"
                  />
                </WrapPanel>
                <TextBlock Text="Arquivo" Style="{StaticResource RibbonGroupLabel}" />
              </StackPanel>
              <Border Width="1" Background="#E5EBF1" Margin="10,7,10,0" />
              <StackPanel>
                <WrapPanel>
                  <Button
                    x:Name="SaveButton"
                    Content="Salvar"
                    Click="SaveClick"
                    Style="{StaticResource RibbonCommand}"
                    Tag="Save"
                  />
                  <Button
                    x:Name="SaveAsButton"
                    Content="Salvar como…"
                    Click="SaveAsClick"
                    Style="{StaticResource RibbonCommand}"
                    Tag="SaveAs"
                  />
                </WrapPanel>
                <TextBlock Text="Salvar projeto" Style="{StaticResource RibbonGroupLabel}" />
              </StackPanel>
              <Border Width="1" Background="#E5EBF1" Margin="10,7,10,0" />
              <StackPanel>
                <WrapPanel>
                  <Button
                    x:Name="SettingsButton"
                    Content="Configurações"
                    Click="SettingsClick"
                    Style="{StaticResource RibbonCommand}"
                    Tag="Settings"
                  />
                  <Button x:Name="UpdateButton" Content="Verificar atualizações" Click="UpdatesClick" Style="{StaticResource RibbonCommand}" Tag="Updates" ToolTip="Verificar novas versões no GitHub Releases" />
                  <Button Content="Manual do DendroLab" Click="ManualClick" Style="{StaticResource RibbonCommand}" Tag="Contents" ToolTip="Manual de ferramentas e configurações" />
                </WrapPanel>
                <TextBlock Text="Preferências" Style="{StaticResource RibbonGroupLabel}" />
              </StackPanel>
            </StackPanel>
          </TabItem>
          <TabItem Header="Inventário">
            <StackPanel HorizontalAlignment="Left" Margin="9,4">
              <WrapPanel>
                <Button
                  x:Name="VolumeButton"
                  Content="Modelos volumétricos"
                  Click="VolumeClick"
                  Style="{StaticResource RibbonCommand}"
                  Tag="Volume"
                />
                <Button x:Name="TaperButton" Content="Modelos de Afilamento" Click="TaperClick"
                        Style="{StaticResource RibbonCommand}" Tag="Volume"
                        ToolTip="Ajustar modelos de afilamento com dados de cubagem e consultar ajustes salvos." />
                <Button
                  x:Name="GrowthButton"
                  Content="Crescimento e produção"
                  Click="GrowthClick"
                  Style="{StaticResource RibbonCommand}"
                  Tag="Growth"
                />
                <Button
                  x:Name="SiteIndexButton"
                  Content="Índice de sítio"
                  Click="SiteIndexClick"
                  Style="{StaticResource RibbonCommand}"
                  Tag="SiteIndex"
                  ToolTip="Abrir o catálogo de curvas-base para modelos de índice de sítio."
                />
                <Button
                  x:Name="SavedRegressionsButton"
                  Content="Regressões salvas"
                  Click="SavedRegressionsClick"
                  Style="{StaticResource RibbonCommand}"
                  Tag="Regression"
                  ToolTip="Abrir o catálogo geral de regressões ajustadas e aplicá-las a uma base."
                />
              </WrapPanel>
              <TextBlock Text="Modelagem florestal" Style="{StaticResource RibbonGroupLabel}" />
            </StackPanel>
          </TabItem>
          <TabItem Header="GIS">
            <StackPanel Orientation="Horizontal" Margin="9,4">
              <StackPanel>
                <WrapPanel>
                  <Button x:Name="GISButton" Content="Abrir GIS" Click="GISClick" Style="{StaticResource RibbonCommand}" Tag="Map" ToolTip="Abrir o mapa base e as camadas raster e vetoriais do projeto." />
                  <Button Content="Imagens NOAA" Click="NoaaNdviClick" Style="{StaticResource RibbonCommand}" Tag="Map" ToolTip="Baixar imagens NOAA em RGB natural ou NDVI e adicioná-las ao mapa do projeto." />
                  <Button Content="Imagens Sentinel‑2" Click="Sentinel2NdviClick" Style="{StaticResource RibbonCommand}" Tag="Map" ToolTip="Buscar cenas Copernicus Sentinel‑2 e gerar imagens RGB ou índices espectrais para o projeto." />
                </WrapPanel>
                <TextBlock Text="Mapa, camadas e satélite" Style="{StaticResource RibbonGroupLabel}" />
              </StackPanel>
            </StackPanel>
          </TabItem>
          <TabItem Header="Exibir">
            <StackPanel Orientation="Horizontal" Margin="9,4">
              <StackPanel>
                <WrapPanel>
                  <Button
                    Content="Conteúdos"
                    Click="ContentsClick"
                    Style="{StaticResource RibbonCommand}"
                    Tag="Contents"
                  />
                  <Button
                    Content="Ferramentas"
                    Click="ToolsClick"
                    Style="{StaticResource RibbonCommand}"
                    Tag="Tools"
                  />
                  <Button
                    Content="Histórico"
                    Click="HistoryClick"
                    Style="{StaticResource RibbonCommand}"
                    Tag="History"
                  />
                  <Button x:Name="RegressionModelsButton" Content="Modelos do ajuste" Click="RegressionModelsClick" Style="{StaticResource RibbonCommand}" Tag="Regression" IsEnabled="False" />
                  <Button x:Name="RegressionDataButton" Content="Dados do ajuste" Click="RegressionDataClick" Style="{StaticResource RibbonCommand}" Tag="Contents" IsEnabled="False" />
                </WrapPanel>
                <TextBlock Text="Painéis" Style="{StaticResource RibbonGroupLabel}" />
              </StackPanel>
              <Border Width="1" Background="#E5EBF1" Margin="10,7,10,0" />
              <StackPanel>
                <WrapPanel>
                  <Button
                    Content="Restaurar layout"
                    Click="ResetLayoutClick"
                    Style="{StaticResource RibbonCommand}"
                    Tag="Layout"
                  />
                </WrapPanel>
                <TextBlock Text="Área de trabalho" Style="{StaticResource RibbonGroupLabel}" />
              </StackPanel>
            </StackPanel>
          </TabItem>
        </TabControl>
      </DockPanel>
    </Border>
    <Border x:Name="StatusBarHost" DockPanel.Dock="Bottom" Height="38" Background="#F5F8FB" BorderBrush="#DBE3EC" BorderThickness="0,1,0,0" Padding="12,0">
      <Grid HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="Crie ou abra um projeto para começar." TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#526D84" />
        <StackPanel x:Name="ProgressDisplay" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18,0" Visibility="Collapsed">
          <ProgressBar x:Name="Progress" Style="{StaticResource StatusProgress}" Width="230" Height="10" Minimum="0" Maximum="100" VerticalAlignment="Center" />
          <TextBlock x:Name="ProgressPercent" Text="0%" Width="42" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="#3C607D" />
        </StackPanel>
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <local:Flags />
          <Button x:Name="CancelOperationButton" Content="Cancelar" Visibility="Collapsed" Click="CancelOperationClick" Margin="10,0,0,0" Padding="9,2" />
        </StackPanel>
      </Grid>
    </Border>
    <Border x:Name="DocumentNavigationHost" DockPanel.Dock="Top" Visibility="Collapsed"
            Background="#F5F8FB" BorderBrush="#DBE3EC" BorderThickness="0,0,0,1" Padding="8,3">
      <StackPanel x:Name="DocumentNavigationButtons" Orientation="Horizontal" HorizontalAlignment="Right" />
    </Border>
    <ad:DockingManager
      x:Name="DockManager"
      Background="#EBF0F5"
      AnchorableTitleTemplate="{StaticResource PaneTitle}"
      AnchorableHeaderTemplate="{StaticResource PaneTabTitle}"
    >
      <ad:DockingManager.Resources>
        <Style
          TargetType="adc:LayoutAnchorableControl"
          BasedOn="{StaticResource RoundedAnchorable}"
        />
      </ad:DockingManager.Resources>
      <ad:DockingManager.Theme>
        <themes:Vs2013LightTheme />
      </ad:DockingManager.Theme>
      <ad:LayoutRoot>
        <ad:LayoutPanel Orientation="Vertical">
          <ad:LayoutPanel Orientation="Horizontal">
            <ad:LayoutAnchorablePane DockWidth="245">
              <ad:LayoutAnchorable
                x:Name="ContentsPane"
                Title="Conteúdos"
                ContentId="contents"
                CanClose="False"
                CanHide="True"
              >
                <DockPanel Background="White">
                  <StackPanel x:Name="ContentSearchPanel" DockPanel.Dock="Top" Margin="10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid>
                        <TextBox x:Name="ContentSearch" Margin="0" MinHeight="34"
                                 ToolTip="Pesquisar conteúdos (Ctrl+Shift+L)"
                                 AutomationProperties.Name="Pesquisar conteúdos"
                                 TextChanged="ContentSearchChanged" />
                        <StackPanel x:Name="ContentSearchHint" Orientation="Horizontal" Margin="10,0"
                                    VerticalAlignment="Center" IsHitTestVisible="False">
                          <StackPanel.Style>
                            <Style TargetType="StackPanel">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Text, ElementName=ContentSearch}" Value="" />
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=ContentSearch}" Value="False" />
                                  </MultiDataTrigger.Conditions>
                                  <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                              </Style.Triggers>
                            </Style>
                          </StackPanel.Style>
                          <local:CommandIcon Kind="Search" Width="14" Height="14" Margin="0,0,6,0" Tint="{StaticResource Ui.Muted}" />
                          <TextBlock Text="Pesquisar conteúdos" Foreground="{StaticResource Ui.Muted}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                      </Grid>
                      <Button x:Name="AddDataButton" Grid.Column="1" Click="AddDataClick"
                              Width="34" MinHeight="34" Margin="6,0,0,0" Padding="7"
                              ToolTip="Adicionar dados" AutomationProperties.Name="Adicionar dados">
                        <local:CommandIcon Kind="Add" Width="18" Height="18" />
                      </Button>
                    </Grid>
                  </StackPanel>
                  <TreeView
                    x:Name="ContentsTree"
                    VirtualizingStackPanel.IsVirtualizing="True"
                    VirtualizingStackPanel.VirtualizationMode="Recycling"
                    BorderThickness="0"
                    Margin="6"
                    MouseDoubleClick="TreeDoubleClick"
                    PreviewKeyDown="ContentsKeyDown"
                  />
                </DockPanel>
              </ad:LayoutAnchorable>
            </ad:LayoutAnchorablePane>
            <ad:LayoutDocumentPane x:Name="Documents" />
            <ad:LayoutAnchorablePane DockWidth="310">
              <ad:LayoutAnchorable
                x:Name="ToolsPane"
                Title="Ferramentas"
                ContentId="tools"
                CanClose="False"
                CanHide="True"
              >
                <DockPanel Background="White">
                  <StackPanel x:Name="ToolSearchPanel" DockPanel.Dock="Top" Margin="10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid>
                        <TextBox x:Name="ToolSearch" Margin="0" MinHeight="34"
                                 ToolTip="Pesquisar ferramentas (Ctrl+Shift+K)"
                                 AutomationProperties.Name="Pesquisar ferramentas"
                                 TextChanged="ToolSearchChanged" />
                        <StackPanel x:Name="ToolSearchHint" Orientation="Horizontal" Margin="10,0"
                                    VerticalAlignment="Center" IsHitTestVisible="False">
                          <StackPanel.Style>
                            <Style TargetType="StackPanel">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Text, ElementName=ToolSearch}" Value="" />
                                    <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=ToolSearch}" Value="False" />
                                  </MultiDataTrigger.Conditions>
                                  <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                              </Style.Triggers>
                            </Style>
                          </StackPanel.Style>
                          <local:CommandIcon Kind="Search" Width="14" Height="14" Margin="0,0,6,0" Tint="{StaticResource Ui.Muted}" />
                          <TextBlock Text="Pesquisar ferramentas" Foreground="{StaticResource Ui.Muted}" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                      </Grid>
                      <Button x:Name="ClearToolSearchButton" Grid.Column="1" Click="ClearToolSearchClick"
                              Width="34" MinHeight="34" Margin="6,0,0,0" Padding="7"
                              ToolTip="Limpar busca e filtros" AutomationProperties.Name="Limpar busca e filtros">
                        <local:CommandIcon Kind="Broom" Width="18" Height="18" />
                      </Button>
                    </Grid>
                    <ComboBox
                      x:Name="ToolCategoryFilter"
                      Margin="0,7,0,0"
                      MinHeight="30"
                      SelectedIndex="0"
                      ToolTip="Filtrar ferramentas por área"
                      SelectionChanged="ToolCategoryChanged"
                    >
                      <ComboBoxItem Content="Todas as categorias" Tag="" />
                      <ComboBoxItem Content="Dados e inventário" Tag="Preparar e revisar dados" />
                      <ComboBoxItem Content="Gráficos e modelos" Tag="Gráficos e modelos" />
                      <ComboBoxItem Content="Comparação e validação" Tag="Comparar e validar" />
                      <ComboBoxItem Content="Campo" Tag="Planejamento de campo" />
                      <ComboBoxItem Content="Mapa e satélite" Tag="Mapa e satélite" />
                    </ComboBox>
                  </StackPanel>
                  <ContentControl x:Name="ToolContent" />
                </DockPanel>
              </ad:LayoutAnchorable>
            </ad:LayoutAnchorablePane>
          </ad:LayoutPanel>
          <ad:LayoutAnchorablePane DockHeight="150">
            <ad:LayoutAnchorable
              x:Name="HistoryPane"
              Title="Histórico"
              ContentId="history"
              CanClose="False"
              CanHide="True"
            >
              <DockPanel Background="White">
                <Button
                  DockPanel.Dock="Top"
                  Content="Limpar histórico"
                  HorizontalAlignment="Right"
                  Click="ClearHistoryClick"
                />
                <TextBox
                  x:Name="HistoryText"
                  IsReadOnly="True"
                  AcceptsReturn="True"
                  TextWrapping="Wrap"
                  BorderThickness="0"
                  VerticalScrollBarVisibility="Auto"
                  Margin="8"
                />
              </DockPanel>
            </ad:LayoutAnchorable>
          </ad:LayoutAnchorablePane>
        </ad:LayoutPanel>
      </ad:LayoutRoot>
    </ad:DockingManager>
  </DockPanel>
</Window>
