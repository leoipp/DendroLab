			}, {
				"nome":	"Máx. de DAP",
				"coluna":	"DAP",
				"funcao":	"max"
			}, {
				"nome":	"Mín. de DAP",
				"coluna":	"DAP",
				"funcao":	"min",
				"filtro":	"> 0"
			}, {
