				"filtro":	"> 0"
			}, {
				"nome":	"Média de H",
				"coluna":	"H",
				"funcao":	"mean",
				"filtro":	"> 0"
			}, {
				"nome":	"Mín. de H",
				"coluna":	"H",
				"funcao":	"min",
				"filtro":	"> 0"
			}, {
				"nome":	"Gini_DAP",
				"coluna":	"DAP",
				"funcao":	"gini",
				"filtro":	"> 0"
			}, {
				"nome":	"Homog_DAP",
				"formula":	"1 - Gini_DAP"
			}, {
				"nome":	"AS",
				"formula":	"pi()*(DAP/10)^2/40000"
			}]
	},
